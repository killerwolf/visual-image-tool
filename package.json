{
	"name": "@h4md1/visual-image-tool",
	"version": "0.2.5",
	"description": "A lightweight vanilla JavaScript tool to define focus points and crop zones on images",
	"main": "dist/visual-image-tool.cjs",
	"module": "dist/visual-image-tool.esm.js",
	"browser": "dist/visual-image-tool.umd.js",
	"exports": {
		".": {
			"import": "./dist/visual-image-tool.esm.js",
			"require": "./dist/visual-image-tool.cjs",
			"default": "./dist/visual-image-tool.esm.js"
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"files": ["dist", "src"],
	"scripts": {
		"build": "rollup -c",
		"dev": "rollup -c -w",
		"demo": "npx http-server -o ./demo",
		"publish:demo": "gh-pages -d demo --nojekyll --src \"**/!(index-local).*\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "npm run build",
		"lint:check": "biome check .",
		"lint:fix": "biome check --write .",
		"format:check": "prettier --check --ignore-unknown .",
		"format:fix": "prettier --write --ignore-unknown ."
	},
	"keywords": [
		"image",
		"crop",
		"focus-point",
		"vanilla-js",
		"image-editor",
		"crop-tool"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@rollup/plugin-node-resolve": "^16.0.1",
		"@rollup/plugin-terser": "^0.4.4",
		"gh-pages": "^6.3.0",
		"jsdom": "^24.1.3",
		"prettier": "3.5.3",
		"rollup": "^4.12.0",
		"vitest": "^1.6.1"
	},
	"type": "module",
	"engines": {
		"node": ">=18.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/killerwolf/visual-image-tool.git"
	},
	"bugs": {
		"url": "https://github.com/killerwolf/visual-image-tool/issues"
	},
	"homepage": "https://h4md1.fr/visual-image-tool/"
}
